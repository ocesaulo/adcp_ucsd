# Manually curated per-cruise image files are not committed (uploaded
# separately per admin.html). Site-wide chrome — the generated Antarctic and
# CalCOFI CODAS galleries and the harvested branding assets (logos, hero
# photos) used on every page load — are reproducible static portal assets and
# are versioned.
images/*
!images/antarctic-webpy/
!images/antarctic-webpy/**
!images/calcofi-webpy/
!images/calcofi-webpy/**
!images/branding/
!images/branding/**

# Raw material for the site (tarballs, scraped copies of the old portal).
# The three calibration pages are the exception: they are the source
# data/calibrations.json is derived from, they are small, and adcp.ucsd.edu
# will not outlive this site.
input_info/*
!input_info/harvest/

# Local tooling. harvest_calibrations.py produces data/calibrations.json, which
# is committed; the script itself is kept out, like the CODAS builders in
# ../../science/technical_sadcp/scripts/. admin.html lives here too — it is a
# local composer that emits JSON to paste into site_data.json, serves no
# purpose on the published site, and staying unpublished keeps it out of the
# WCAG 2.1 AA scope the DOJ ADA Title II rule puts on the portal.
tools/

__pycache__/
