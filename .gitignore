# Manually curated per-cruise image files are not committed (uploaded
# separately per admin.html). Site-wide chrome — the generated Antarctic
# CODAS gallery and the harvested branding assets (logos, hero photos) used
# on every page load — are reproducible static portal assets and are versioned.
images/*
!images/antarctic-webpy/
!images/antarctic-webpy/**
!images/branding/
!images/branding/**

# Raw material for the site (tarballs, scraped copies of the old portal).
# The three calibration pages are the exception: they are the source
# data/calibrations.json is derived from, they are small, and adcp.ucsd.edu
# will not outlive this site.
input_info/*
!input_info/harvest/

# Local tooling. harvest_calibrations.py produces data/calibrations.json, which
# is committed; the script itself is kept out, like the CODAS builders in
# ../../science/technical_sadcp/scripts/.
tools/

__pycache__/
