  "_README": {
    "description": "Master data file for the Chereskin Lab ADCP Data Portal. Edit this file to update all site content. Then run 'python3 -m http.server 8000' and open localhost:8000 to preview changes.",
    "image_paths": "All image filenames in cruise.images[] are relative to the images/ folder. Example: 'nh9310_100_oa.jpg' → place file at images/nh9310_100_oa.jpg",
    "track_format": "cruise.track is an array of [latitude, longitude] pairs forming the cruise track polyline. Latitude: negative = South. Longitude: negative = West.",
    "station_format": "cruise.stations is an array of {lat, lon, label} objects for individual station markers on the map.",
    "status_values": ["processed", "archived", "in_review", "pending"],
    "image_type_values": ["velocity_plot", "cruise_photo", "station_map", "echo_intensity", "calibration"],
    "ncei_url_note": "Replace ncei_url with the permanent NCEI accession permalink for each cruise. Format: https://www.ncei.noaa.gov/data/oceans/accession/XXXXXXX/",
    "last_updated": "2024-01-01",
    "contact": "Chereskin Lab, Scripps Institution of Oceanography, UCSD"
  },

