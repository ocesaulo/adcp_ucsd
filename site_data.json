{
  "_README": {
    "description": "Master data file for the Chereskin Lab ADCP Data Portal. Edit this file to update all site content. Then run 'python3 -m http.server 8000' and open localhost:8000 to preview changes.",
    "image_paths": "All image filenames in cruise.images[] are relative to the images/ folder. Example: 'nh9310_100_oa.jpg' → place file at images/nh9310_100_oa.jpg",
    "track_format": "cruise.track is an optional array of [latitude, longitude] pairs used only when no measured track exists in data/drake_passage_tracks.json.",
    "station_format": "cruise.stations is an array of {lat, lon, label} objects for individual station markers on the map.",
    "status_values": [
      "processed",
      "archived",
      "in_review",
      "pending"
    ],
    "image_type_values": [
      "velocity_plot",
      "cruise_photo",
      "station_map",
      "echo_intensity",
      "calibration"
    ],
    "ncei_url_note": "Replace ncei_url with the permanent NCEI accession permalink for each cruise. Format: https://www.ncei.noaa.gov/data/oceans/accession/XXXXXXX/",
    "last_updated": "2026-08-06",
    "contact": "Chereskin Lab, Scripps Institution of Oceanography, UCSD",
    "tracks_file": "data/drake_passage_tracks.json holds the measured ship tracks (ensembles with valid u and v) and the per-depth-bin data-coverage statistics extracted from the CODAS databases with pysadcp. A cruise is linked to its track through cruise.track_key. Regenerate it with make_drake_passage_web_tracks.py (kept outside this repository, it needs pycurrents/CODAS and the raw loads)."
  },
  "site": {
    "title": "Chereskin Lab · ADCP Data Portal",
    "institution": "Scripps Institution of Oceanography",
    "institution_url": "https://scripps.ucsd.edu",
    "lab_url": "http://tryfan.ucsd.edu",
    "original_site_url": "https://adcp.ucsd.edu",
    "jasadcp_url": "https://uhslc.soest.hawaii.edu/sadcp/",
    "ncei_search_base": "https://www.ncei.noaa.gov/access/search/data-search/global-ocean-currents?text=",
    "citation": "Chereskin, T.K. (2008). CalCOFI ADCP Digital Atlas. Scripps Institution of Oceanography, UC San Diego. http://adcp.ucsd.edu/calcofi",
    "footer_note": "Data archived at NCEI / NOAA. Processing via CODAS3."
  },
  "projects": [
    {
      "id": "antarctic",
      "name": "Antarctic — Laurence M. Gould",
      "short_name": "Antarctic LMG",
      "region": "Southern Ocean",
      "color": "#0e8c7a",
      "color_light": "#e0f4f1",
      "vessel": "ARSV Laurence M. Gould",
      "years": "2004–2023",
      "description": "Shipboard ADCP data from cruises aboard the ARSV Laurence M. Gould in Drake Passage and along the western Antarctic Peninsula. Upper-ocean currents were measured with a hull-mounted 150 kHz narrowband RDI instrument and, from 2019, an additional 38 kHz Ocean Surveyor.",
      "methods_text": "Data processed using CODAS3 with standard heading calibration procedures. Bottom tracking was available for shallow transits near the Peninsula. Navigation corrections applied via differential GPS.",
      "map_center": [
        -61,
        -61
      ],
      "map_zoom": 5,
      "references": [
        "Chereskin, T.K. and Trunnell, M. (1996). Correlation scales, objective mapping, and absolute geostrophic velocity in the California Current. J. Geophys. Res., 101(C10), 22619–22629.",
        "Lenn, Y.-D., Chereskin, T.K., Sprintall, J. and McClean, J.L. (2011). Near-surface eddy heat and momentum fluxes in the Antarctic Circumpolar Current in Drake Passage. J. Phys. Oceanogr., 41, 1385–1407."
      ],
